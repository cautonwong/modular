#!/bin/sh
#
# Commit-message gate (ticket #41): CONTRIBUTING.md documents Conventional
# Commits, so enforce it before the commit lands instead of discovering it in CI.
#
# Merge commits, GitHub-generated reverts and dependabot commits are exempt.
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass a single commit:  git commit --no-verify

set -u

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

[ $# -ge 1 ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
    echo "commit-msg: python3 not found; message gate skipped here (CI still enforces it)" >&2
    exit 0
fi

if ! out=$(python3 .github/scripts/check_commit_messages.py --file "$1" 2>&1); then
    echo "commit-msg: $out" >&2
    echo "commit-msg: commit message rejected -- see CONTRIBUTING.md 'Commit messages'" >&2
    exit 1
fi
exit 0
